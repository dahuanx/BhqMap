<?xml version="1.0" encoding="utf-8"?>
<!-- 显示控制浮层（v2 · 弹窗版，2026-09-24）
     相对 v1（dialog_project_filter.xml）的改动：
       1. 承载方式：AlertDialog 居中白底 → PopupWindow 锚定右侧主按钮 btnCoop，在按钮左侧弹出；
       2. 底色：白 → 深色玻璃 #141608 @90%，与圆形悬浮按钮同一套语言；
       3. 每行新增「示例色块」12dp，颜色 = 开启后标签全称的专属色；
       4. 仍不写副标题（v0.7.15 洲哥定的规矩：只有类别名 + 控件）。
     三个开关语义（自 v0.7.15 起统一，不改动）：
       关（默认）= 简称，与普通企业一字不差；
       开        = 全称 + 专属色（协作区沙金 / 园区亮橄榄 / 规上湖蓝）。

     v0.7.27 新增第四行「闲置地块」（洲哥 2026-09-24 要求）——
       前三行管的是**标签样式**，第四行管的是**图层**：打开后地图上多出一层
       "闲置地块框体 + 框体中央的名称"，同时前三项被程序强制关闭并置灰，
       所有企业名称一并撤下（圆点保留）。语义差异用示例色块的形状表达：
       前三行实心块（标签颜色）、第四行空心框（框体颜色）。

     v0.7.28 再加第五行「闲置厂房」—— 同属"图层"，故沿用空心方框，
       靠颜色区分：紫 = 闲置地块（面），珊瑚橙 = 闲置厂房（点）。
       两个图层**双向互斥**：打开任一个，另一个若在开状态会被程序关闭。
       开关区至此五行封顶（v0.8.0 加的是分隔线下的**动作行**，不计入开关行上限）。

     v0.7.22 宽度改造（洲哥反馈「框体太宽、已顶到右侧屏幕边界」）——
       病根不是"设得太宽"，是**测量被撑满**：原先根布局固定 196dp，
       但行内文字用「layout_width=0dp + layout_weight=1」，而 MainActivity 用
       measure(AT_MOST(屏宽)) 去自量尺寸。AT_MOST 不是精确规格，0dp+weight 的子项
       会被撑到可用宽度上限 ⇒ 自量宽度 ≈ 满屏 ⇒ xoff 算成巨大的负值、浮层被推到
       屏幕外，又被 PopupWindow 默认的"裁剪回屏幕"拽回来 ⇒ 满屏宽、左右都贴边。
       现改为：根 wrap_content；行 wrap_content；**文字列固定 80dp**（5 字 ×15sp≈75dp，
       留 5dp 余量）—— 三行因此等宽，开关纵向对齐，整体宽度由内容自然决定（约 176dp）。
       代码侧改用实测宽度显式建 PopupWindow，不再依赖 WRAP_CONTENT 二次测量。
       注意：文字列宽度是"对齐锚"，改类别名文字（超 5 字）时要同步放大。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- 协作区项目 -->
    <LinearLayout
        android:id="@+id/rowCoop"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_coop" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="协作区项目"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swCoop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/sw_thumb_tint"
            app:trackTint="@color/sw_track_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_popup" />

    <!-- 园区项目 -->
    <LinearLayout
        android:id="@+id/rowPark"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_park" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="园区项目"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swPark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/sw_thumb_tint"
            app:trackTint="@color/sw_track_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_popup" />

    <!-- 规上企业 -->
    <LinearLayout
        android:id="@+id/rowAbove"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_above" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="规上企业"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAbove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/sw_thumb_tint"
            app:trackTint="@color/sw_track_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_popup" />

    <!-- 闲置地块（v0.7.27 第四行）
         前三行是"标签样式"开关（开了名字变颜色），后两行是**图层**开关（开了地图多一层），
         语义不同 —— 所以示例色块画成空心方框（=框体），与前三个实心色块在形状上就分得开。
         打开本项时前三项会被程序强制置灰关闭、且与本行下的「闲置厂房」互斥
         （两者同时只能开一个），详见 MainActivity.onLayerToggled。 -->
    <LinearLayout
        android:id="@+id/rowIdle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_idle" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="闲置地块"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swIdle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/sw_thumb_tint"
            app:trackTint="@color/sw_track_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_popup" />

    <!-- 闲置厂房（v0.7.28 第五行）
         与第四行同款空心方框（都是图层），靠颜色区分：紫 = 闲置地块（面），
         珊瑚橙 = 闲置厂房（点）。两行**互斥**，同时只能开一个 ——
         互相打开的瞬间，另一行会被程序置为关闭（见 MainActivity.onLayerToggled）。
         本行是浮层的**最后一行**：五行是当前上限，再加要么把行高压下去、
         要么把浮层撑到屏幕外，两者都不划算。 -->
    <LinearLayout
        android:id="@+id/rowFactory"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_factory" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="闲置厂房"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swFactory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/sw_thumb_tint"
            app:trackTint="@color/sw_track_tint" />
    </LinearLayout>

    <!-- v0.8.0 第六行「导入台账 Excel」：开关区到此为止，本行是**动作行**（不占开关行上限）。
         与 Web 版 v0.3.0 的面板同构：分隔线 + 动作行；色块用虚线沙金框（dot_import）——
         实心块 = 标签样式、空心实线框 = 图层、虚线框 = 动作（点了打开文件选择器）。
         点击行为在 MainActivity.showDisplayPanel 挂接：先收起浮层，再进系统文件选择器。
         文字列不用 80dp 对齐锚（"导入台账 Excel" 超五字且本行无开关要对齐），用 wrap_content。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_popup" />

    <LinearLayout
        android:id="@+id/rowImport"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_import" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="导入台账 Excel"
            android:textColor="#FFF2F0E6"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="›"
            android:textColor="#80F2F0E6"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
