<?xml version="1.0" encoding="utf-8"?>
<!-- 版权信息页底（v0.7.30）：深色玻璃 #141608 @92% + 16dp 圆角 + 1dp 15% 白描边。
     与显示控制浮层（bg_popup_panel，14dp 圆角 / 90%）同一套语言，两处各放大一档 ——
     浮层是"从按钮边上长出来的一角"，这页是"盖在地图上的整页纸"：
     体量更大、字更小（10~11sp 的说明文字），所以底色要更实，否则底下影像的亮瓦片会糊字。
     玻璃感仍然只靠「半透明 + 描边 + elevation」，不加投影、不加渐变。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/about_panel_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/about_panel_line" />
</shape>
