<?xml version="1.0" encoding="utf-8"?>
<!-- 控制面板浮层底（v1.0）：深色玻璃 #141608 @90% + 14dp 圆角 + 1dp 15% 白描边
     与右侧圆形悬浮按钮同一套语言（底色同源 #141608），但透明度提到 90% ——
     按钮只有图标、可 55%，浮层里要承载 15sp 文字，必须压到足够暗才保证长文本可读。
     玻璃感靠「半透明 + 描边 + elevation」，不加投影、不加渐变。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6141608" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
