<?xml version="1.0" encoding="utf-8"?>
<!-- 版权信息页·图标容器底（v0.7.30）
     它只干一件事：给 ImageView 提供一个 **12dp 圆角的 outline**，
     配合 android:clipToOutline="true" 把自适应图标裁成圆角方形 ——
     版权页上用的是**真实的 launcher 图标**（@mipmap/ic_launcher），
     而自适应图标是 108dp 方形画布，直接摆进深色面板会露出四个直角，与全页的圆角语言冲突。
     solid 取图标自身的深底 #2F3A1E：万一某密度档下图标边缘有透明像素，
     露出来的是同色系，不会出现白角。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF2F3A1E" />
    <corners android:radius="12dp" />
</shape>
