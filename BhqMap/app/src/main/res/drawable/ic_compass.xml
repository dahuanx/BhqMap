<?xml version="1.0" encoding="utf-8"?>
<!-- 指北针（右上角）：双色指针 + N 字，北针沙金、南针卡其白降透明。
     地图不旋转时指针恒指正上（正北），仅作方位提示。

     v0.5（洲哥 2026-09-22）：指针加大、N 字缩小。
       指针三角形：底宽 3.0 → 5.0 单位，北针长 5.4 → 7.6 单位；
       N 字：宽 5.8 → 4.0 单位，笔画 1.7 → 1.2；
       android:width/height 24dp → 30dp，整个图形在按钮里再放大一档。
       合并效果：指针在屏幕上约为原来的 1.6 倍，N 字略小于原来。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- "N"（缩小） -->
    <path
        android:pathData="M10.0,5.3 L10.0,2.7 L14.0,5.3 L14.0,2.7"
        android:strokeColor="#F2F0E6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 北针（沙金，加长加宽） -->
    <path
        android:pathData="M12,7.4 L14.5,15 L9.5,15 Z"
        android:fillColor="#D9B95C" />
    <!-- 南针（卡其白 50%） -->
    <path
        android:pathData="M12,21.6 L9.5,15 L14.5,15 Z"
        android:fillColor="#80F2F0E6" />
</vector>
