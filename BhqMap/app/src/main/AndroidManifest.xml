<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 瓦片下载与网络状态判断 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位按钮（v0.3）：运行时弹窗授权，拒绝则不启用定位层 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 应用内更新（v0.9.0）：下载安装包后拉起系统安装器。
         Android 8.0 起这是**必须声明**的权限，且用户还要为"本应用"单独打开
         「安装未知应用」开关 —— 代码只能引导到设置页（见 update/ApkInstaller.kt）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BhqMap">

        <!-- 锁定竖屏：园区呈南北竖长条形，竖屏与全貌比例契合；
             同时避免旋转后“全貌”装框失效。需横屏时改 screenOrientation 即可。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider（v0.9.0）：把下载好的安装包以 content:// URI 交给系统安装器。
             exported=false + grantUriPermissions=true 是标准安全配置：
             不对外暴露目录，只在每次安装时临时授予读权限。
             可暴露的路径白名单在 res/xml/file_paths.xml。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
